@model HomeModel
@{
    Layout = null;
    ViewData["TitleKey"] = "home.pageTitle";
    ViewData["Title"] = L["home.pageTitle"];


    // Mashq turlari: (controller, matn kaliti, savollar soni, daraja kaliti)
    var practice = new[]
    {
        ("Testforty", "nav.q20", 20, "hm.lvl1"),
        ("Testsixty", "nav.q40", 40, "hm.lvl2"),
        ("Testeighty", "nav.q80", 80, "hm.lvl3"),
        ("Testhundred", "nav.q100", 100, "hm.lvl4"),
        ("Testhundredsixty", "nav.q200", 200, "hm.lvl5"),
    };
}
<!DOCTYPE html>
<html lang="@L.HtmlLang" data-lang="@L.Lang" data-title-key="home.pageTitle" data-title-suffix=" — AVTOPRAVA_SAM" data-lang-reload>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] — AVTOPRAVA_SAM</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <partial name="_I18nScripts" />
    <style>
        body.hm { margin: 0; background: var(--ca-bg); color: var(--ca-text); font-family: var(--ca-font); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
        .hm *, .hm *::before, .hm *::after { box-sizing: border-box; }
        .hm [hidden] { display: none !important; }
        .hm-wrap { width: min(1240px, 100%); margin: 0 auto; padding: 0 clamp(16px, 3vw, 32px); }
        .hm-section { margin-top: clamp(28px, 4vw, 48px); }
        .hm-sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
        .hm-sec-title { margin: 0; font-size: clamp(1.15rem, 2vw, 1.45rem); font-weight: 800; color: #fff; letter-spacing: -.01em; }
        .hm-sec-sub { margin: 4px 0 0; color: var(--ca-muted); font-size: .9rem; }

        /* ── Yuqori qism ── */
        .hm-hero { position: relative; padding: clamp(24px, 4vw, 44px) 0 0; }
        .hm-hero::before {
            content: ""; position: absolute; inset: -80px 0 auto 0; height: 520px; z-index: -1; pointer-events: none;
            background: radial-gradient(600px 300px at 15% 20%, rgba(255,45,74,.16), transparent 70%),
                        radial-gradient(500px 280px at 85% 10%, rgba(56,189,248,.10), transparent 70%);
        }
        .hm-hero-grid { text-align: center; }
        .hm-hero-grid .hm-lead { margin-left: auto; margin-right: auto; }
        .hm-hero-grid .hm-search { margin: 0 auto; text-align: left; }
        .hm-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        .hm-lead { margin: 0 0 22px; color: var(--ca-muted); font-size: clamp(.95rem, 1.4vw, 1.08rem); line-height: 1.55; max-width: 56ch; }

        /* Qidiruv */
        .hm-search { position: relative; max-width: 680px; }
        .hm-search-field { position: relative; display: block; }
        .hm-search-field > svg { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); width: 22px; height: 22px; color: var(--ca-faint); pointer-events: none; }
        .hm-search-input {
            width: 100%; height: 62px; padding: 0 128px 0 54px; border-radius: 18px; outline: none;
            border: 1px solid var(--ca-border-strong); background: var(--ca-surface); color: var(--ca-text);
            font: 600 1.02rem var(--ca-font); box-shadow: var(--ca-shadow); transition: border-color .15s, box-shadow .15s;
        }
        .hm-search-input::placeholder { color: var(--ca-faint); font-weight: 500; }
        .hm-search-input::-webkit-search-cancel-button { display: none; }
        .hm-search-input:focus { border-color: var(--ca-brand); box-shadow: 0 0 0 4px var(--ca-brand-soft), var(--ca-shadow); }
        .hm-search-btn {
            position: absolute; right: 8px; top: 8px; height: 46px; padding: 0 20px; border: 0; border-radius: 12px; cursor: pointer;
            background: linear-gradient(135deg, #ff2d4a, #ff5a3c); color: #fff; font: 700 .9rem var(--ca-font);
        }
        .hm-search-btn:hover { filter: brightness(1.08); }
        .hm-suggest {
            position: absolute; left: 0; right: 0; top: 70px; z-index: 30; overflow: hidden; border-radius: 16px;
            background: var(--ca-bg-2); border: 1px solid var(--ca-border-strong); box-shadow: var(--ca-shadow-lg);
        }
        .hm-sg-item { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 12px; align-items: center; padding: 10px 14px; text-decoration: none; border-bottom: 1px solid var(--ca-border); color: var(--ca-text); }
        .hm-sg-item:hover, .hm-sg-item.on { background: var(--ca-surface-2); }
        .hm-sg-thumb { width: 48px; height: 38px; border-radius: 8px; overflow: hidden; background: var(--ca-surface-2); display: grid; place-items: center; color: var(--ca-faint); }
        .hm-sg-thumb img { width: 100%; height: 100%; object-fit: cover; }
        .hm-sg-thumb svg { width: 18px; height: 18px; }
        .hm-sg-text { font-size: .9rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .hm-sg-text mark { background: rgba(255,45,74,.22); color: #fff; border-radius: 3px; padding: 0 2px; }
        .hm-sg-num { font-size: .72rem; font-weight: 700; color: var(--ca-faint); margin-right: 6px; }
        .hm-sg-foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 14px; color: var(--ca-brand); font-weight: 700; font-size: .86rem; text-decoration: none; }
        .hm-sg-foot:hover, .hm-sg-foot.on { background: var(--ca-surface-2); }
        .hm-sg-empty { padding: 16px 14px; color: var(--ca-muted); font-size: .9rem; }
        .hm-search-hint { margin-top: 10px; color: var(--ca-faint); font-size: .8rem; }


        /* Real imtihon banneri */
        .hm-exam {
            position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 42%); align-items: center; gap: 16px;
            border-radius: 24px; padding: clamp(22px, 3.5vw, 36px); text-decoration: none; isolation: isolate; color: var(--ca-text);
            background: linear-gradient(120deg, #2a0a12 0%, #160a10 45%, #0f1018 100%); border: 1px solid rgba(255,45,74,.35);
            transition: transform .2s, box-shadow .2s, border-color .2s;
        }
        .hm-exam::after { content: ""; position: absolute; inset: auto -20% -60% 30%; height: 120%; background: radial-gradient(closest-side, rgba(255,45,74,.28), transparent); z-index: -1; }
        .hm-exam:hover { transform: translateY(-3px); border-color: rgba(255,45,74,.7); box-shadow: 0 24px 60px rgba(255,45,74,.18); color: var(--ca-text); }
        .hm-exam-badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: rgba(255,45,74,.16); color: #ff8a9b; font-size: .76rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
        .hm-exam-badge i { width: 8px; height: 8px; border-radius: 50%; background: #ff2d4a; box-shadow: 0 0 0 4px rgba(255,45,74,.25); animation: hm-pulse 1.8s infinite; }
        @@keyframes hm-pulse { 50% { box-shadow: 0 0 0 8px rgba(255,45,74,0); } }
        .hm-exam h2 { margin: 14px 0 8px; font-size: clamp(1.6rem, 3.4vw, 2.4rem); font-weight: 900; color: #fff; letter-spacing: -.02em; }
        .hm-exam p { margin: 0 0 20px; color: #d6d8e0; font-size: .98rem; line-height: 1.55; max-width: 48ch; }
        .hm-exam-facts { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
        .hm-exam-facts span { padding: 6px 12px; border-radius: 10px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.08); font-size: .82rem; font-weight: 600; color: #e9eaf0; }
        .hm-cta { display: inline-flex; align-items: center; gap: 10px; padding: 14px 22px; border-radius: 14px; background: linear-gradient(135deg, #ff2d4a, #ff5a3c); color: #fff; font-weight: 800; font-size: .95rem; box-shadow: 0 10px 30px rgba(255,45,74,.35); }
        .hm-cta svg { width: 18px; height: 18px; }
        .hm-exam-final { grid-template-columns: minmax(0, 1fr) auto; }
        .hm-final-ic { width: clamp(120px, 16vw, 180px); aspect-ratio: 1; border-radius: 32px; display: grid; place-items: center; margin-right: clamp(0px, 3vw, 40px);
            background: radial-gradient(circle at 30% 25%, rgba(255,122,69,.35), rgba(255,45,74,.12) 60%, transparent); border: 1px solid rgba(255,45,74,.35); color: #ffb199; transition: transform .3s; }
        .hm-final-ic svg { width: 46%; height: 46%; }
        .hm-exam-final:hover .hm-final-ic { transform: rotate(-6deg) scale(1.04); }
        .hm-exam-img { width: 100%; max-height: 240px; object-fit: contain; filter: drop-shadow(0 30px 40px rgba(0,0,0,.6)); transition: transform .3s; }
        .hm-exam:hover .hm-exam-img { transform: translateX(8px) scale(1.02); }

        /* Mashq turlari */
        .hm-practice { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
        .hm-tile {
            position: relative; display: flex; flex-direction: column; gap: 6px; padding: 18px; border-radius: 18px; text-decoration: none; color: var(--ca-text);
            background: var(--ca-surface); border: 1px solid var(--ca-border); transition: transform .18s, border-color .18s, box-shadow .18s;
        }
        .hm-tile:hover { transform: translateY(-3px); border-color: var(--ca-border-strong); box-shadow: var(--ca-shadow); color: var(--ca-text); }
        .hm-tile-num { font-size: 2.3rem; font-weight: 900; line-height: 1; color: #fff; letter-spacing: -.03em; }
        .hm-tile-unit { font-size: .82rem; font-weight: 700; color: var(--ca-muted); }
        .hm-tile-lvl { margin-top: 8px; align-self: flex-start; font-size: .72rem; font-weight: 700; padding: 4px 9px; border-radius: 999px; background: var(--ca-brand-soft); color: #ff8a9b; }
        .hm-tile-go { position: absolute; right: 14px; top: 16px; width: 30px; height: 30px; border-radius: 10px; display: grid; place-items: center; background: rgba(255,255,255,.04); color: var(--ca-muted); transition: all .18s; }
        .hm-tile-go svg { width: 16px; height: 16px; }
        .hm-tile:hover .hm-tile-go { background: var(--ca-brand); color: #fff; }

        /* Bo'limlar */
        .hm-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
        .hm-card {
            display: flex; flex-direction: column; gap: 10px; padding: 20px; border-radius: 18px; text-decoration: none; min-height: 170px; color: var(--ca-text);
            background: var(--ca-surface); border: 1px solid var(--ca-border); transition: transform .18s, border-color .18s, box-shadow .18s;
        }
        .hm-card:hover { transform: translateY(-3px); border-color: var(--ca-border-strong); box-shadow: var(--ca-shadow); color: var(--ca-text); }
        .hm-ic { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; }
        .hm-ic svg { width: 22px; height: 22px; }
        .hm-ic.red { background: rgba(255,45,74,.14); color: #ff6b81; }
        .hm-ic.blue { background: rgba(56,189,248,.14); color: #38bdf8; }
        .hm-ic.green { background: rgba(34,197,94,.14); color: #4ade80; }
        .hm-ic.amber { background: rgba(245,165,36,.14); color: #fbbf24; }
        .hm-ic.violet { background: rgba(167,139,250,.14); color: #c4b5fd; }
        .hm-card h3 { margin: 4px 0 0; font-size: 1.05rem; font-weight: 800; color: #fff; }
        .hm-card p { margin: 0; color: var(--ca-muted); font-size: .86rem; line-height: 1.5; }
        .hm-card-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: .82rem; font-weight: 700; color: var(--ca-text); }
        .hm-card-foot svg { width: 16px; height: 16px; color: var(--ca-muted); transition: transform .18s, color .18s; }
        .hm-card:hover .hm-card-foot svg { transform: translateX(3px); color: var(--ca-brand); }

        .hm-footer { margin-top: clamp(40px, 6vw, 72px); border-top: 1px solid var(--ca-border); padding: 22px 0 28px; color: var(--ca-faint); font-size: .82rem; }
        .hm-footer .hm-wrap { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
        .hm-footer b { color: #fff; }

        @@media (max-width: 1100px) {
            .hm-practice { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .hm-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @@media (max-width: 900px) {
            .hm-exam { grid-template-columns: 1fr; }
            .hm-exam-img { max-height: 180px; order: -1; }
            .hm-exam-final { grid-template-columns: 1fr; }
            .hm-final-ic { display: none; }
        }
        @@media (max-width: 560px) {
            .hm-practice { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .hm-practice .hm-tile:last-child { grid-column: 1 / -1; }
            .hm-cards { grid-template-columns: 1fr; }
            .hm-card { min-height: 0; }
            .hm-search-input { height: 56px; padding-right: 16px; font-size: .98rem; }
            .hm-search-btn { display: none; }
            .hm-suggest { top: 64px; }
        }
        @@media (prefers-reduced-motion: reduce) { .hm *, .hm *::after { animation: none !important; transition: none !important; } }
    </style>
</head>
<body class="hm">
    <header class="ui-header">
        <div class="ui-header-inner">
            <a class="ui-brand" asp-controller="Home" asp-action="Index" aria-label="AVTOPRAVA_SAM">
                <img src="~/images/logo-96.png" alt="" />
                <span>AVTOPRAVA_SAM</span>
            </a>
            <div class="ui-header-actions">
                <a class="ui-home-link" asp-controller="Cabinet" asp-action="Index">
                    @Icons.Grid <span data-i18n="nav.myCabinet">@L["nav.myCabinet"]</span>
                </a>
                <partial name="_LangDropdown" />
                <partial name="_UserMenu" />
            </div>
        </div>
    </header>

    <main>
        <!-- Savol qidirish -->
        <section class="hm-hero">
            <div class="hm-wrap hm-hero-grid">
                <div>
                    <h1 class="hm-sr" data-i18n="home.pageTitle">@L["home.pageTitle"]</h1>
                    <p class="hm-lead" data-i18n="hm.lead">@L["hm.lead"]</p>

                    <form class="hm-search" id="hmSearch" action="/Cabinet/Search" method="get" role="search" autocomplete="off">
                        <label class="hm-search-field">
                            @Icons.Search
                            <input type="search" name="q" id="hmQ" class="hm-search-input" maxlength="200" spellcheck="false"
                                   placeholder="@L["hm.searchPlaceholder"]" data-i18n-placeholder="hm.searchPlaceholder"
                                   aria-label="@L["sq.title"]" aria-autocomplete="list" aria-controls="hmSuggest" aria-expanded="false" />
                        </label>
                        <button type="submit" class="hm-search-btn" data-i18n="hm.searchBtn">@L["hm.searchBtn"]</button>
                        <div class="hm-suggest" id="hmSuggest" role="listbox" hidden></div>
                    </form>
                    <div class="hm-search-hint" data-i18n="hm.searchHint">@L["hm.searchHint"]</div>
                </div>

            </div>
        </section>

        <!-- Mavzular (asosiy banner) -->
        <section class="hm-section">
            <div class="hm-wrap">
                <a class="hm-exam" asp-controller="Topic" asp-action="Index">
                    <div>
                        <span class="hm-exam-badge"><i></i><span data-i18n="hm.topicsBadge">@L["hm.topicsBadge"]</span></span>
                        <h2 data-i18n="nav.topics">@L["nav.topics"]</h2>
                        <p data-i18n="hm.topicsBannerDesc">@L["hm.topicsBannerDesc"]</p>
                        <div class="hm-exam-facts">
                            <span>@L.F("hm.topicsFact1", ("n", Model.TopicCount))</span>
                            <span data-i18n="hm.topicsFact2">@L["hm.topicsFact2"]</span>
                            <span data-i18n="hm.topicsFact3">@L["hm.topicsFact3"]</span>
                        </div>
                        <span class="hm-cta">@Icons.Book <span data-i18n="hm.topicsStart">@L["hm.topicsStart"]</span></span>
                    </div>
                    <img class="hm-exam-img" src="~/images/avprsm1 rrr.png" alt="" decoding="async" />
                </a>
            </div>
        </section>

        <!-- Mashq turlari -->
        <section class="hm-section">
            <div class="hm-wrap">
                <div class="hm-sec-head">
                    <div>
                        <h2 class="hm-sec-title" data-i18n="hm.practiceTitle">@L["hm.practiceTitle"]</h2>
                        <p class="hm-sec-sub" data-i18n="hm.practiceSub">@L["hm.practiceSub"]</p>
                    </div>
                </div>
                <div class="hm-practice">
                    @foreach (var (ctrl, key, n, lvl) in practice)
                    {
                        <a class="hm-tile" asp-controller="@ctrl" asp-action="Index" aria-label="@L[key]">
                            <span class="hm-tile-go">@Icons.ArrowRight</span>
                            <span class="hm-tile-num">@n</span>
                            <span class="hm-tile-unit" data-i18n="hm.questions">@L["hm.questions"]</span>
                            <span class="hm-tile-lvl" data-i18n="@lvl">@L[lvl]</span>
                        </a>
                    }
                </div>
            </div>
        </section>

        <!-- Boshqa bo'limlar -->
        <section class="hm-section">
            <div class="hm-wrap">
                <div class="hm-sec-head">
                    <div>
                        <h2 class="hm-sec-title" data-i18n="hm.modesTitle">@L["hm.modesTitle"]</h2>
                        <p class="hm-sec-sub" data-i18n="hm.modesSub">@L["hm.modesSub"]</p>
                    </div>
                </div>
                <div class="hm-cards">
                    <a class="hm-card" asp-controller="Bilet" asp-action="Index">
                        <span class="hm-ic blue">@Icons.List</span>
                        <h3 data-i18n="nav.bilets">@L["nav.bilets"]</h3>
                        <p>@L.F("hm.biletsDesc", ("n", Model.BiletCount))</p>
                        <span class="hm-card-foot"><span data-i18n="hm.open">@L["hm.open"]</span>@Icons.ArrowRight</span>
                    </a>
                    <a class="hm-card" asp-controller="TestAll" asp-action="Index">
                        <span class="hm-ic amber">@Icons.Flame</span>
                        <h3 data-i18n="nav.marathon">@L["nav.marathon"]</h3>
                        <p>@L.F("hm.marathonDesc", ("n", Model.BankSize))</p>
                        <span class="hm-card-foot"><span data-i18n="hm.start">@L["hm.start"]</span>@Icons.ArrowRight</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- Real imtihon — eng oxirida: mashqlardan keyingi yakuniy sinov -->
        <section class="hm-section">
            <div class="hm-wrap">
                <a class="hm-exam hm-exam-final" asp-controller="Test" asp-action="Index">
                    <div>
                        <span class="hm-exam-badge"><i></i><span data-i18n="hm.examBadge">@L["hm.examBadge"]</span></span>
                        <h2 data-i18n="nav.real">@L["nav.real"]</h2>
                        <p data-i18n="hm.examDesc">@L["hm.examDesc"]</p>
                        <div class="hm-exam-facts">
                            <span data-i18n="hm.examFact1">@L["hm.examFact1"]</span>
                            <span data-i18n="hm.examFact2">@L["hm.examFact2"]</span>
                            <span data-i18n="hm.examFact3">@L["hm.examFact3"]</span>
                        </div>
                        <span class="hm-cta">@Icons.Play <span data-i18n="hm.examStart">@L["hm.examStart"]</span></span>
                    </div>
                    <span class="hm-final-ic" aria-hidden="true">@Icons.Trophy</span>
                </a>
            </div>
        </section>
    </main>

    <footer class="hm-footer">
        <div class="hm-wrap">
            <span><b>AVTOPRAVA_SAM</b> · © @DateTime.Now.Year</span>
            <span data-i18n="footer.rights">@L["footer.rights"]</span>
        </div>
    </footer>

    <script src="~/js/ui.js" asp-append-version="true"></script>
    <script>
    (function () {
        "use strict";

        // ── Savol qidirish: yozish davomida eng mos 6 ta savol; Enter — barcha natijalar sahifasi ──
        var form = document.getElementById("hmSearch"), input = document.getElementById("hmQ"), box = document.getElementById("hmSuggest");
        var timer = null, seq = 0, active = -1;
        var ICON_IMG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/></svg>';

        function esc(s) {
            return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
                return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
            });
        }
        function tokens(q) {
            var base = q.toLowerCase().replace(/['`´‘’ʻʼ]/g, "").split(/[^\p{L}\p{N}]+/u).filter(function (t) { return t.length >= 2; });
            var res = base.slice();
            base.forEach(function (t) { var c = I18n.toCyrillic ? I18n.toCyrillic(t).toLowerCase() : t; if (c && res.indexOf(c) < 0) res.push(c); });
            return res.sort(function (a, b) { return b.length - a.length; });
        }
        function highlight(text, toks) {
            text = String(text == null ? "" : text);
            if (!toks.length) return esc(text);
            var re;
            try {
                re = new RegExp(toks.map(function (t) {
                    return Array.from(t).map(function (ch) { return ch.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"); }).join("['`´‘’ʻʼ]?");
                }).join("|"), "giu");
            } catch (e) { return esc(text); }
            var out = "", last = 0, m;
            while ((m = re.exec(text)) !== null) {
                if (!m[0]) { re.lastIndex++; continue; }
                out += esc(text.slice(last, m.index)) + "<mark>" + esc(m[0]) + "</mark>";
                last = m.index + m[0].length;
            }
            return out + esc(text.slice(last));
        }
        function tooShort(q) { return q.replace(/['`´‘’ʻʼ\s]/g, "").length < 2 && !/^#?\d+$/.test(q); }
        function close() { box.hidden = true; active = -1; input.setAttribute("aria-expanded", "false"); }

        function suggest() {
            var q = input.value.trim();
            if (tooShort(q)) { close(); return; }
            var my = ++seq;
            fetch("/Cabinet/SearchQuestions?q=" + encodeURIComponent(q), { headers: { Accept: "application/json" }, cache: "no-store" })
                .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
                .then(function (d) {
                    if (my !== seq || input.value.trim() !== q) return;
                    var toks = tokens(q), items = (d.items || []).slice(0, 6), html = "";
                    if (!items.length) html = '<div class="hm-sg-empty">' + esc(I18n.t("sq.emptyTitle")) + "</div>";
                    items.forEach(function (it) {
                        var x = it.question;
                        var thumb = x.imageUrl ? '<img alt="" loading="lazy" src="/uploads/' + encodeURIComponent(x.imageUrl) + '?w=160">' : ICON_IMG;
                        html += '<a class="hm-sg-item" role="option" href="/Cabinet/Practice?ids=' + x.id + "&q=" + encodeURIComponent(q) + '">' +
                            '<span class="hm-sg-thumb">' + thumb + "</span>" +
                            '<span class="hm-sg-text"><span class="hm-sg-num">#' + x.id + "</span>" +
                            highlight(I18n.pick(x.questionUZ, x.questionRU, x.questionUZK), toks) + "</span></a>";
                    });
                    if (d.total > 0) {
                        html += '<a class="hm-sg-foot" href="/Cabinet/Search?q=' + encodeURIComponent(q) + '"><span>' +
                            esc(I18n.t("hm.allResults", { n: d.total })) + "</span><span>→</span></a>";
                    }
                    box.innerHTML = html;
                    box.hidden = false;
                    active = -1;
                    input.setAttribute("aria-expanded", "true");
                })
                .catch(function () { if (my === seq) close(); });
        }

        input.addEventListener("input", function () { clearTimeout(timer); timer = setTimeout(suggest, 200); });
        input.addEventListener("focus", function () { if (box.innerHTML && !tooShort(input.value.trim())) box.hidden = false; });
        input.addEventListener("keydown", function (e) {
            var links = box.hidden ? [] : box.querySelectorAll("a");
            if (e.key === "Escape") { close(); return; }
            if (!links.length) return;
            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                e.preventDefault();
                active = (active + (e.key === "ArrowDown" ? 1 : -1) + links.length) % links.length;
                links.forEach(function (a, i) { a.classList.toggle("on", i === active); });
            } else if (e.key === "Enter" && active >= 0) {
                e.preventDefault();
                location.href = links[active].href;
            }
        });
        form.addEventListener("submit", function (e) { if (!input.value.trim()) { e.preventDefault(); input.focus(); } });
        document.addEventListener("click", function (e) { if (!form.contains(e.target)) close(); });
        document.addEventListener("keydown", function (e) {
            var tag = document.activeElement ? document.activeElement.tagName : "";
            if (e.key === "/" && !/INPUT|TEXTAREA|SELECT/.test(tag)) { e.preventDefault(); input.focus(); }
        });
        // Orqaga qaytilganda (brauzer keshi) eski ro'yxat ochiq qolmasin
        window.addEventListener("pageshow", function () { close(); });
    })();
    </script>
</body>
</html>
