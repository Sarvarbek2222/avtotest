@model List<DayStat>
@* 30 kunlik taraqqiyot: ustunlar — javoblar soni, chiziq — to'g'ri javoblar ulushi (server tomonida chiziladigan SVG) *@
@using System.Globalization
@{
    const double W = 640, H = 220, padL = 34, padR = 10, padT = 12, padB = 26;
    double plotW = W - padL - padR, plotH = H - padT - padB;
    int n = Model.Count;
    double step = n > 0 ? plotW / n : plotW;
    int maxCount = Math.Max(1, Model.Max(d => d.Answered));
    var inv = CultureInfo.InvariantCulture;
    string F(double v) => v.ToString("0.#", inv);
    double X(int i) => padL + step * i + step / 2;
    double Y(double acc) => padT + plotH * (1 - acc);

    var pts = Model.Select((d, i) => (d, i)).Where(p => p.d.Answered > 0).Select(p => $"{F(X(p.i))},{F(Y(p.d.Accuracy))}").ToList();
    bool any = pts.Count > 0;
}
<div class="ca-card">
    <div class="ca-card-head">
        <div>
            <h3 class="ca-card-title" data-i18n="cab.progress">@L["cab.progress"]</h3>
            <p class="ca-card-sub" data-i18n="cab.progressHint">@L["cab.progressHint"]</p>
        </div>
    </div>
    @if (!any)
    {
        <p class="ca-muted" data-i18n="cab.noActivity">@L["cab.noActivity"]</p>
    }
    else
    {
        <svg class="ca-chart" viewBox="0 0 @F(W) @F(H)" role="img" aria-label="@L["cab.progress"]">
            <defs>
                <linearGradient id="caLine" x1="0" x2="1">
                    <stop offset="0" stop-color="#ff2d4a" />
                    <stop offset="1" stop-color="#ff7a45" />
                </linearGradient>
            </defs>
            @foreach (var g in new[] { 0.0, 0.5, 0.9, 1.0 })
            {
                <line x1="@F(padL)" x2="@F(W - padR)" y1="@F(Y(g))" y2="@F(Y(g))"
                      stroke="@(g == 0.9 ? "rgba(34,197,94,.45)" : "rgba(255,255,255,.07)")" stroke-dasharray="@(g == 0.9 ? "4 4" : "")" />
                @:<text x="@F(padL - 6)" y="@F(Y(g) + 4)" text-anchor="end" font-size="10" fill="#8e93a8">@((int)(g * 100))%</text>
            }
            @for (int i = 0; i < n; i++)
            {
                var d = Model[i];
                if (d.Answered == 0) { continue; }
                double h = plotH * 0.45 * d.Answered / maxCount;
                <rect x="@F(X(i) - step * 0.32)" y="@F(padT + plotH - h)" width="@F(step * 0.64)" height="@F(h)" rx="2" fill="rgba(56,189,248,.28)">
                    <title>@d.Date.ToString("dd.MM") — @d.Answered · @Score.Pct(d.Accuracy)%</title>
                </rect>
            }
            <polyline points="@string.Join(" ", pts)" fill="none" stroke="url(#caLine)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
            @for (int i = 0; i < n; i++)
            {
                var d = Model[i];
                if (d.Answered > 0)
                {
                    <circle cx="@F(X(i))" cy="@F(Y(d.Accuracy))" r="3.2" fill="#ff2d4a" stroke="#12141c" stroke-width="1.5" />
                }
                if (i % 5 == 0 || i == n - 1)
                {
                    @:<text x="@F(X(i))" y="@F(H - 8)" text-anchor="middle" font-size="10" fill="#8e93a8">@d.Date.ToString("dd.MM")</text>
                }
            }
        </svg>
        <div class="ca-chart-legend">
            <span><i style="background:linear-gradient(90deg,#ff2d4a,#ff7a45)"></i><span data-i18n="cab.colAccuracy">@L["cab.colAccuracy"]</span></span>
            <span><i style="background:rgba(56,189,248,.5)"></i><span data-i18n="cab.colAnswered">@L["cab.colAnswered"]</span></span>
            <span><i style="background:rgba(34,197,94,.7)"></i>90%</span>
        </div>
    }
</div>
