@using System.Text.Json

@{
    Layout = null;
    var topic = ViewData["Topic"]?.ToString() ?? "";

    ViewData["Title"] = L.Topic(topic);

    var topicJson = JsonSerializer.Serialize(topic);

    // Mavzu nomi 3 tilda (xato xabarida tanlangan tilda ko'rsatish uchun)
    var topicNamesJson = JsonSerializer.Serialize(new
    {
        uz = Topics.Display(topic, Lang.Uz),
        ru = Topics.Display(topic, Lang.Ru),
        uzk = Topics.Display(topic, Lang.Uzk)
    });
}

<!DOCTYPE html>
<html lang="@L.HtmlLang" data-lang="@L.Lang" >

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />

    <partial name="_I18nScripts" />

    <style>

            /* =========================
                       LANGUAGE
                       ========================= */

            .top-lang .lang-btn {
                background-color: #111111;
                color: #f0f0f0;
                border: 1.5px solid #555555;
                padding: 4px 10px;
                margin: 0 2px;
                font-weight: 700;
                cursor: pointer;
                border-radius: 3px;
                transition: all 0.2s;
            }

                .top-lang .lang-btn:hover {
                    background-color: #2a2a2a;
                    color: #ffffff;
                    border-color: #aaaaaa;
                }

                .top-lang .lang-btn.active {
                    background-color: #ffffff !important;
                    color: #000000 !important;
                    border-color: #ffffff !important;
                }

            .top-lang.mx-auto {
                margin-left: auto !important;
                margin-right: auto !important;
            }


            /* =========================
                       NAVBAR
                       ========================= */

            .custom-nav {
                background-color: #0a0a0a !important;
                border-bottom: 1px solid #222222;
            }

            .logo-img {
                border-radius: 80%;
                height: 50px;
                width: auto;
                max-height: 60px;
            }

            .logo-text {
                font-weight: 700;
                font-size: 1.3rem;
                letter-spacing: 1px;
                color: #ffffff;
                white-space: nowrap;
                text-shadow: 0 0 12px rgba(255,255,255,0.3);
            }


            /* =========================
                       BODY
                       ========================= */

            html,
            body {
                margin: 0;
                padding: 0;
                width: 100%;
                min-height: 100%;
                background-color: #141414;
                color: #f8f9fa;
                font-family: Roboto, "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
                font-size: 16px;
            }

                body a {
                    color: white;
                }

                body .navbar,
                body .card,
                body .modal-content,
                body .dropdown-menu {
                    background-color: #0a0a0a;
                    color: #f0f0f0;
                    border-color: #2a2a2a;
                }


            /* =========================
                       QUESTION
                       ========================= */

            .container {
                max-width: 100%;
                padding: 4px;
                margin: 6px;
                box-sizing: border-box;
            }

            #questionBox {
                width: 100%;
                margin: 0;
                box-sizing: border-box;
                background-color: #555;
                color: white;
            }

                #questionBox h3 {
                    color: white;
                    text-align: center;
                }


            /* =========================
                       OPTIONS
                       ========================= */

            .option-row {
                display: flex;
                margin-bottom: 6px;
                cursor: pointer;
                transition: background-color 0.2s;
            }

                .option-row:not(.answered):hover .option-text {
                    background-color: #3c4a3d99;
                }

                .option-row.answered {
                    cursor: default;
                }

            .option-btn {
                min-width: 50px;
                padding: 4px 12px;
                background-color: #1a547b;
                color: #f8f9fa;
                border-radius: 0;
                border-style: solid;
                border-width: 2px;
                border-top-color: rgba(255,255,255,0.25);
                border-left-color: rgba(255,255,255,0.25);
                border-bottom-color: #000;
                border-right-color: #000;
                font-weight: bold;
                user-select: none;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .option-text {
                flex: 1 1 auto;
                background-color: #3c4a3d;
                color: #f8f9fa;
                padding: 4px 14px;
                border-radius: 0;
                border-style: solid;
                border-width: 2px;
                border-top-color: rgba(255,255,255,0.25);
                border-bottom-color: #000;
                border-right-color: #000;
                border-left: none;
                font-size: 1rem;
                line-height: 1.4;
                font-weight: 400;
                text-align: left;
                display: flex;
                align-items: center;
                transition: background-color 0.2s;
            }

            .option-row.correct .option-btn {
                background-color: #1a7a1a !important;
            }

            .option-row.correct .option-text {
                background-color: #4caf50 !important;
                color: #000 !important;
            }

            .option-row.incorrect .option-btn {
                background-color: #7a1a1a !important;
            }

            .option-row.incorrect .option-text {
                background-color: #e53935 !important;
                color: white !important;
            }


            /* =========================
                       IMAGE
                       ========================= */

            .image-col {
                padding-right: 105px;
            }


            /* =========================
                       NAVIGATION
                       ========================= */

            .nav-wrapper {
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-top: 40px;
            }

            #questionNav {
                display: grid !important;
                grid-template-columns: repeat(20, 36px);
                gap: 3px;
                justify-content: center;
                margin: 0 auto;
            }

                #questionNav button {
                    border-radius: 0 !important;
                    background-color: #3c4a3d !important;
                    color: #f8f9fa !important;
                    border-style: solid !important;
                    border-width: 2px !important;
                    border-top-color: #000 !important;
                    border-left-color: #000 !important;
                    border-bottom-color: rgba(255,255,255,0.35) !important;
                    border-right-color: rgba(255,255,255,0.35) !important;
                    width: 36px;
                    height: 36px;
                    flex-shrink: 0;
                    padding: 0 !important;
                    font-size: 12px !important;
                }

                    #questionNav button:hover {
                        background-color: #3c4a3d99 !important;
                    }

                    #questionNav button.btn-success {
                        background-color: #4caf50 !important;
                        color: #000 !important;
                    }

                    #questionNav button.btn-danger {
                        background-color: #e53935 !important;
                    }

                    #questionNav button.btn-primary {
                        background-color: #2b362c !important;
                        color: #f8f9fa !important;
                        box-shadow: inset 3px 3px 6px rgba(0,0,0,0.75) !important;
                    }


            /* =========================
                       BUTTONS
                       ========================= */

            .finish-btn {
                position: absolute;
                right: 30px;
                top: 50%;
                transform: translateY(-50%);
                background-color: #3c4a3d;
                color: #ffffff;
                border: 2px solid #000;
                border-radius: 0;
                padding: 12px 26px;
                font-size: 15px;
                font-weight: 600;
                cursor: pointer;
            }

                .finish-btn:hover {
                    background-color: #3c4a3d99;
                }

            .exit-btn {
                position: absolute;
                left: 30px;
                top: 50%;
                transform: translateY(-50%);
                background-color: #6c3a3a;
                color: #ffffff;
                border: 2px solid #000;
                border-radius: 0;
                padding: 12px 26px;
                font-size: 15px;
                font-weight: 600;
                cursor: pointer;
            }

                .exit-btn:hover {
                    background-color: #6c3a3a99;
                }


            /* =========================
                       ERROR
                       ========================= */

            #errorBox {
                display: none;
                background: #7a1a1a;
                color: white;
                padding: 15px;
                margin-top: 15px;
                border: 2px solid #e53935;
                white-space: pre-wrap;
                word-break: break-word;
            }


            /* =========================
                       RESULT
                       ========================= */

            #resultCard {
                display: none;
                position: fixed;
                bottom: 20px;
                left: 50%;
                transform: translateX(-50%);
                max-width: 400px;
                width: 90%;
                z-index: 1000;
            }


            /* =========================
                       MOBILE
                       ========================= */

            @@media (max-width: 768px) {

                .image-col {
                    padding-right: 15px;
                    padding-left: 15px;
                    margin-top: 16px;
                }

                    .image-col > div {
                        height: 260px !important;
                    }

                .nav-wrapper {
                    flex-direction: column;
                    gap: 16px;
                }

                .finish-btn,
                .exit-btn {
                    position: static;
                    transform: none;
                }

                #questionNav {
                    display: flex !important;
                    flex-wrap: wrap;
                    gap: 2px;
                    margin: 20px 8px 0 8px;
                }
            }
    </style>

</head>

<body>

    <!-- =========================
         NAVBAR
         ========================= -->

    <partial name="_TestHeader" />


    <!-- =========================
         MAIN
         ========================= -->

    <div class="container mt-4">

        <div class="container-fluid p-0"
             style="margin-top:-22px;">

            <!-- QUESTION -->

            <div id="questionBox"
                 class="p-3">

                <h3 id="questionText"
                    class="m-0 p-2">@L["test.loading"]</h3>

            </div>


            <!-- ERROR -->

            <div id="errorBox"></div>


            <!-- QUESTION + IMAGE -->

            <div class="row mt-4">

                <div class="col-md-6"
                     id="optionsContainer">
                </div>


                <div class="col-md-6 image-col">

                    <div style="
                        width:100%;
                        height:400px;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        overflow:hidden;">

                        <img id="questionImage"
                             style="
                        max-width:100%;
                        max-height:100%;
                        width:auto;
                        height:auto;
                        object-fit:contain;
                        cursor:pointer;"
                             src="/images/rasm.png"
                             alt="@L["test.imageAlt"]" data-i18n-alt="test.imageAlt">

                    </div>

                </div>

            </div>


            <!-- NAVIGATION -->

            <div class="nav-wrapper">

                <button id="exitBtn"
                        class="exit-btn"
                        type="button" data-i18n="test.exit">@L["test.exit"]</button>


                <div id="questionNav"></div>


                <button id="finishBtn"
                        class="finish-btn"
                        type="button" data-i18n="test.finish">@L["test.finish"]</button>

            </div>

        </div>


        <!-- =========================
             RESULT
             ========================= -->

        <div id="resultCard"
             class="card text-center p-3">

            <div class="card-body">

                <h4 class="card-title" data-i18n="test.result">@L["test.result"]</h4>

                <p id="resultText"
                   class="card-text">
                </p>

                <div class="d-flex flex-wrap justify-content-center">

                    <button id="reviewBtn"
                            class="btn btn-primary m-1" data-i18n="test.review">@L["test.review"]</button>

                    <button id="reviewErrorsBtn"
                            class="btn btn-warning m-1"
                            style="display:none;" data-i18n="test.reviewErrors">@L["test.reviewErrors"]</button>

                    <button id="retryBtn"
                            class="btn btn-danger m-1" data-i18n="test.retry">@L["test.retry"]</button>

                </div>

            </div>

        </div>


        <!-- =========================
             IMAGE MODAL
             ========================= -->

        <div id="imageModal"
             style="
            display:none;
            position:fixed;
            z-index:5000;
            left:0;
            top:0;
            width:100%;
            height:100%;
            background:rgba(0,0,0,0.92);
            align-items:center;
            justify-content:center;">

            <span id="closeModal"
                  style="
                position:absolute;
                top:16px;
                right:24px;
                font-size:40px;
                color:white;
                cursor:pointer;
                z-index:5001;
                line-height:1;">
                ×
            </span>

            <img id="modalImg"
                 style="
            position:fixed;
            top:50%;
            left:50%;
            transform:translate(-50%,-50%);
            width:92vw;
            height:90vh;
            object-fit:contain;">

        </div>

    </div>


    <script>

            /* =========================================
               VARIABLES
               ========================================= */

            let originalQuestions = [];

            let questions = [];

            let currentIndex = 0;

            let answers = {};

            let lastResult = null; // natija kartasi tanlangan tilda qayta chizilishi uchun

            let shuffledOrders = {};

            let isReviewMode = false;

            let incorrectQuestionsGlobal = [];


            /*
             * MUHIM:
             * Topic Razor orqali JSON ko'rinishida beriladi.
             * Apostrof yoki maxsus belgilar bo'lsa ham JS buzilmaydi.
             */

            const TOPIC = @Html.Raw(topicJson);

            const TOPIC_NAMES = @Html.Raw(topicNamesJson);

            const topicName = () => I18n.pick(TOPIC_NAMES.uz, TOPIC_NAMES.ru, TOPIC_NAMES.uzk);

            document.addEventListener("i18n:change", () => { document.title = topicName(); });


            /* =========================================
               SHUFFLE
               ========================================= */

            function shuffleArray(arr) {

                const a = [...arr];

                for (let i = a.length - 1; i > 0; i--) {

                    const j = Math.floor(Math.random() * (i + 1));

                    [a[i], a[j]] = [a[j], a[i]];
                }

                return a;
            }


            /* =========================================
               PAGE LOAD
               ========================================= */

            document.addEventListener("DOMContentLoaded", async () => {

                try {

                    await loadQuestions();

                    if (questions.length > 0) {

                        renderQuestion();

                    }

                }
                catch (error) {

                    console.error(error);

                    showError(
                        I18n.t("test.pageError") + "\n" +
                        error.message
                    );

                }

            });


            /* =========================================
               LOAD QUESTIONS
               ========================================= */

            async function loadQuestions() {

                try {

                    console.log("TOPIC:", TOPIC);

                    const url =
                        "/Topic/GetQuestions?topic=" +
                        encodeURIComponent(TOPIC);

                    console.log("REQUEST:", url);

                    const res =
                        await fetch(url, {
                            method: "GET",
                            headers: {
                                "Accept": "application/json"
                            }
                        });


                    console.log(
                        "STATUS:",
                        res.status
                    );


                    const text =
                        await res.text();


                    console.log(
                        "SERVER RESPONSE:",
                        text
                    );


                    if (!res.ok) {

                        throw new Error(
                            I18n.t("test.serverError", { status: res.status }) +
                            "\n\n" +
                            text
                        );

                    }


                    let data;

                    try {

                        data = JSON.parse(text);

                    }
                    catch (jsonError) {

                        throw new Error(
                            I18n.t("test.badJson") + "\n\n" +
                            text
                        );

                    }


                    if (!Array.isArray(data)) {

                        if (data.error) {

                            throw new Error(
                                data.message ||
                                I18n.t("test.controllerError")
                            );

                        }

                        throw new Error(
                            I18n.t("test.badData")
                        );

                    }


                    questions = data;


                    /*
                     * Qayta ishlash uchun
                     * original nusxa saqlaymiz.
                     */

                    originalQuestions =
                        JSON.parse(
                            JSON.stringify(data)
                        );


                    console.log(
                        "SAVOLLAR SONI:",
                        questions.length
                    );


                    if (questions.length === 0) {

                        document.getElementById(
                            "questionText"
                        ).innerText =
                            I18n.t("topics.noQuestions");

                        document.getElementById(
                            "optionsContainer"
                        ).innerHTML = "";

                        showError(
                            I18n.t("topics.topic") + ": " +
                            topicName() +
                            "\n\n" +
                            I18n.t("topics.noQuestionsDb")
                        );

                        return;

                    }


                    createNavigation();

                }
                catch (error) {

                    console.error(
                        "GetQuestions xatosi:",
                        error
                    );


                    document.getElementById(
                        "questionText"
                    ).innerText =
                        I18n.t("test.loadError");


                    showError(
                        error.message ||
                        I18n.t("test.unknownError")
                    );

                }

            }


            /* =========================================
               ERROR
               ========================================= */

            function showError(message) {

                const errorBox =
                    document.getElementById("errorBox");

                errorBox.style.display = "block";

                errorBox.innerText =
                    message;

            }


            /* =========================================
               QUESTION TEXT
               ========================================= */

            function getQuestionText(q) {

                // Tanlangan tildagi matn; tarjima bo'lmasa — o'zbek (lotin)
                return I18n.pick(q.questionUZ, q.questionRU, q.questionUZK);
            }


            /* =========================================
               OPTION TEXT
               ========================================= */

            function getOptionText(o) {

                return I18n.pick(o.textUZ, o.textRU, o.textUZK);
            }


            /* =========================================
               SHUFFLE OPTIONS
               ========================================= */

            function getShuffledOptions(q) {

                if (
                    (answers[q.id] !== undefined ||
                        isReviewMode) &&
                    shuffledOrders[q.id]
                ) {

                    return shuffledOrders[q.id]
                        .map(i => q.options[i]);

                }


                const prev =
                    shuffledOrders[q.id]
                        ? [...shuffledOrders[q.id]]
                        : null;


                let indices;

                let attempts = 0;


                do {

                    indices =
                        shuffleArray(
                            q.options.map(
                                (_, i) => i
                            )
                        );

                    attempts++;

                    if (attempts > 20)
                        break;

                }
                while (
                    prev &&
                    JSON.stringify(indices) ===
                    JSON.stringify(prev)
                );


                shuffledOrders[q.id] =
                    indices;


                return indices.map(
                    i => q.options[i]
                );

            }


            /* =========================================
               RENDER QUESTION
               ========================================= */

            function renderQuestion() {

                if (!questions.length) {

                    return;

                }


                if (
                    currentIndex < 0 ||
                    currentIndex >= questions.length
                ) {

                    currentIndex = 0;

                }


                const q =
                    questions[currentIndex];


                if (!q) {

                    return;

                }


                /* QUESTION */

                document.getElementById(
                    "questionText"
                ).innerText =
                    getQuestionText(q);


                /* IMAGE */

                const image =
                    document.getElementById(
                        "questionImage"
                    );


                if (q.imageUrl) {

                    image.src =
                        "/uploads/" +
                        q.imageUrl;

                }
                else {

                    image.src =
                        "/images/avprsm1 rrr.png";

                }


                /* OPTIONS */

                const container =
                    document.getElementById(
                        "optionsContainer"
                    );


                container.innerHTML = "";


                if (
                    !q.options ||
                    q.options.length === 0
                ) {

                    container.innerHTML =
                        `<div style="color:red;padding:20px;">
                                    ${I18n.t("test.noOptions")}
                                </div>`;

                    return;

                }


                const shuffled =
                    getShuffledOptions(q);


                const alreadyAnswered =
                    answers[q.id] !== undefined ||
                    isReviewMode;


                shuffled.forEach(
                    (o, index) => {

                        const div =
                            document.createElement(
                                "div"
                            );


                        div.className =
                            "option-row" +
                            (
                                alreadyAnswered
                                    ? " answered"
                                    : ""
                            );


                        const wrapper =
                            document.createElement(
                                "div"
                            );


                        wrapper.style.display =
                            "flex";

                        wrapper.style.alignItems =
                            "stretch";

                        wrapper.style.width =
                            "100%";


                        const btn =
                            document.createElement(
                                "div"
                            );


                        btn.className =
                            "option-btn";


                        btn.innerText =
                            "F" + (index + 1);


                        const textDiv =
                            document.createElement(
                                "div"
                            );


                        textDiv.className =
                            "option-text";


                        textDiv.innerText =
                            getOptionText(o);


                        wrapper.appendChild(btn);

                        wrapper.appendChild(textDiv);

                        div.appendChild(wrapper);


                        /* ANSWERED */

                        if (alreadyAnswered) {

                            const selectedId =
                                answers[q.id];


                            if (
                                selectedId !==
                                undefined
                            ) {

                                const selected =
                                    q.options.find(
                                        opt =>
                                            opt.id ==
                                            selectedId
                                    );


                                if (selected) {

                                    if (
                                        selected.isCorrect
                                    ) {

                                        if (
                                            o.id ===
                                            selected.id
                                        ) {

                                            div.classList
                                                .add(
                                                    "correct"
                                                );

                                        }

                                    }
                                    else {

                                        if (
                                            o.id ===
                                            selected.id
                                        ) {

                                            div.classList
                                                .add(
                                                    "incorrect"
                                                );

                                        }


                                        if (
                                            o.isCorrect
                                        ) {

                                            div.classList
                                                .add(
                                                    "correct"
                                                );

                                        }

                                    }

                                }

                            }
                            else {

                                if (o.isCorrect) {

                                    div.classList
                                        .add(
                                            "correct"
                                        );

                                }

                            }

                        }
                        else {

                            div.onclick = () => {

                                selectAnswer(
                                    q,
                                    o
                                );

                            };

                        }


                        container.appendChild(
                            div
                        );

                    }
                );


                updateNavigation();

            }


            /* =========================================
               SELECT ANSWER
               ========================================= */

            function selectAnswer(q, o) {

                if (
                    answers[q.id] !== undefined ||
                    isReviewMode
                ) {

                    return;

                }


                answers[q.id] =
                    o.id;


                renderQuestion();

                updateNavigation();

                checkAutoFinish();


                setTimeout(() => {

                    if (
                        currentIndex <
                        questions.length - 1 &&
                        !isReviewMode
                    ) {

                        currentIndex++;

                        renderQuestion();

                    }

                }, 500);

            }


            /* =========================================
               NAVIGATION
               ========================================= */

            function createNavigation() {

                const nav =
                    document.getElementById(
                        "questionNav"
                    );


                nav.innerHTML = "";


                questions.forEach(
                    (q, i) => {

                        const btn =
                            document.createElement(
                                "button"
                            );


                        btn.innerText =
                            i + 1;


                        btn.className =
                            "btn btn-sm btn-outline-secondary";


                        btn.onclick = () => {

                            currentIndex =
                                i;

                            renderQuestion();

                        };


                        nav.appendChild(
                            btn
                        );

                    }
                );


                updateNavigation();

            }


            /* =========================================
               UPDATE NAVIGATION
               ========================================= */

            function updateNavigation() {

                document
                    .querySelectorAll(
                        "#questionNav button"
                    )
                    .forEach(
                        (btn, i) => {

                            btn.className =
                                "btn btn-sm";


                            if (
                                i ===
                                currentIndex
                            ) {

                                btn.classList
                                    .add(
                                        "btn-primary"
                                    );

                            }


                            const q =
                                questions[i];


                            if (!q)
                                return;


                            if (
                                answers[q.id] !==
                                undefined
                            ) {

                                const sel =
                                    q.options.find(
                                        o =>
                                            o.id ==
                                            answers[q.id]
                                    );


                                btn.classList.add(
                                    sel &&
                                        sel.isCorrect
                                        ? "btn-success"
                                        : "btn-danger"
                                );

                            }
                            else {

                                if (isReviewMode) {

                                    btn.classList
                                        .add(
                                            "btn-danger"
                                        );

                                }
                                else {

                                    btn.classList
                                        .add(
                                            "btn-outline-secondary"
                                        );

                                }

                            }

                        }
                    );

            }


            /* =========================================
               AUTO FINISH
               ========================================= */

            function checkAutoFinish() {

                if (
                    Object.keys(answers).length ===
                    questions.length
                ) {

                    finishTest();

                }

            }


            /* =========================================
               FINISH
               ========================================= */

            function finishTest() {

                let correct = 0;

                let skipped = 0;

                incorrectQuestionsGlobal = [];


                questions.forEach(
                    q => {

                        if (
                            answers[q.id] !==
                            undefined
                        ) {

                            const sel =
                                q.options.find(
                                    o =>
                                        o.id ==
                                        answers[q.id]
                                );


                            if (
                                sel &&
                                sel.isCorrect
                            ) {

                                correct++;

                            }
                            else {

                                incorrectQuestionsGlobal
                                    .push(q);

                            }

                        }
                        else {

                            skipped++;

                        }

                    }
                );


                let percentage =
                    questions.length > 0
                        ? Math.round(
                            (
                                correct /
                                questions.length
                            ) * 100
                        )
                        : 0;


                const passThreshold =
                    Math.ceil(
                        questions.length *
                        0.9
                    );


                const resultCard =
                    document.getElementById(
                        "resultCard"
                    );


                resultCard.className =
                    "card text-center p-3 " +
                    (
                        correct >=
                            passThreshold
                            ? "passed"
                            : "failed"
                    );


                lastResult = {
                    bilet: null,
                    correct,
                    total: questions.length,
                    percent: percentage,
                    wrong: incorrectQuestionsGlobal.length,
                    skipped
                };

                renderResultText();


                const errorBtn =
                    document.getElementById(
                        "reviewErrorsBtn"
                    );


                if (
                    incorrectQuestionsGlobal.length >
                    0
                ) {

                    errorBtn.style.display =
                        "inline-block";

                }
                else {

                    errorBtn.style.display =
                        "none";

                }


                resultCard.style.display =
                    "block";

            }


            /* =========================================
               REVIEW ERRORS
               ========================================= */

            document.getElementById(
                "reviewErrorsBtn"
            ).onclick = () => {

                if (
                    incorrectQuestionsGlobal.length >
                    0
                ) {

                    questions =
                        JSON.parse(
                            JSON.stringify(
                                incorrectQuestionsGlobal
                            )
                        );


                    answers = {};

                    shuffledOrders = {};

                    currentIndex = 0;

                    isReviewMode = false;


                    document.getElementById(
                        "resultCard"
                    ).style.display =
                        "none";


                    createNavigation();

                    renderQuestion();

                }

            };


            /* =========================================
               REVIEW
               ========================================= */

            document.getElementById(
                "reviewBtn"
            ).onclick = () => {

                document.getElementById(
                    "resultCard"
                ).style.display =
                    "none";


                isReviewMode = true;

                currentIndex = 0;

                renderQuestion();

            };


            /* =========================================
               RETRY
               ========================================= */

            document.getElementById(
                "retryBtn"
            ).onclick = () => {

                questions =
                    JSON.parse(
                        JSON.stringify(
                            originalQuestions
                        )
                    );


                answers = {};

                shuffledOrders = {};

                currentIndex = 0;

                isReviewMode = false;


                document.getElementById(
                    "resultCard"
                ).style.display =
                    "none";


                createNavigation();

                renderQuestion();

            };


            /* =========================================
               FINISH BUTTON
               ========================================= */

            document.getElementById(
                "finishBtn"
            ).onclick = () => {

                finishTest();

            };


            /* =========================================
               EXIT BUTTON
               ========================================= */

            document.getElementById(
                "exitBtn"
            ).onclick = () => {

                window.location.href =
                    "/Home/Index";

            };


            /* =========================================
               KEYBOARD
               ========================================= */

            document.addEventListener(
                "keydown",
                function(e) {

                    if (
                        e.key === "Escape"
                    ) {

                        document.getElementById(
                            "imageModal"
                        ).style.display =
                            "none";

                        return;

                    }


                    if (
                        e.key === "ArrowRight" &&
                        currentIndex <
                        questions.length - 1
                    ) {

                        currentIndex++;

                        renderQuestion();

                        return;

                    }


                    if (
                        e.key === "ArrowLeft" &&
                        currentIndex > 0
                    ) {

                        currentIndex--;

                        renderQuestion();

                        return;

                    }


                    if (
                        e.key.startsWith("F") &&
                        e.key.length > 1
                    ) {

                        if (isReviewMode)
                            return;


                        const fNum =
                            parseInt(
                                e.key.slice(1)
                            ) - 1;


                        const q =
                            questions[currentIndex];


                        if (
                            !q ||
                            answers[q.id] !==
                            undefined
                        ) {

                            return;

                        }


                        const order =
                            shuffledOrders[q.id];


                        if (
                            order &&
                            order[fNum] !==
                            undefined
                        ) {

                            const o =
                                q.options[
                                order[fNum]
                                ];


                            if (o) {

                                e.preventDefault();

                                selectAnswer(
                                    q,
                                    o
                                );

                            }

                        }

                    }

                }
            );


            /* =========================================
               IMAGE MODAL
               ========================================= */

            document.addEventListener(
                "click",
                function(e) {

                    if (
                        e.target &&
                        e.target.id ===
                        "questionImage"
                    ) {

                        document.getElementById(
                            "modalImg"
                        ).src =
                            e.target.src;


                        document.getElementById(
                            "imageModal"
                        ).style.display =
                            "flex";

                    }

                }
            );


            document.getElementById(
                "closeModal"
            ).onclick = () => {

                document.getElementById(
                    "imageModal"
                ).style.display =
                    "none";

            };


            document.getElementById(
                "imageModal"
            ).onclick = function(e) {

                if (e.target === this) {

                    this.style.display =
                        "none";

                }

            };


            /* =========================================
               LANGUAGE
               ========================================= */

            function renderResultText() {
                if (!lastResult) return;
                const r = lastResult;
                const el = document.getElementById("resultText");
                const lines = [];
                if (r.bilet) lines.push(I18n.t("bilet.title") + r.bilet);
                lines.push(
                    I18n.t("test.correct", { correct: r.correct, total: r.total, percent: r.percent }),
                    I18n.t("test.wrong", { n: r.wrong }),
                    I18n.t("test.skipped", { n: r.skipped })
                );
                el.textContent = "";
                lines.forEach((line, i) => {
                    if (i > 0) el.appendChild(document.createElement("br"));
                    el.appendChild(document.createTextNode(line));
                });
            }

            // Til almashtirilganda (sahifa qayta yuklanmaydi) — savol va natijani qayta chizamiz
            document.addEventListener("i18n:change", () => {
                if (questions.length > 0) renderQuestion();
                renderResultText();
            });

    </script>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>